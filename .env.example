# Скопируй в .env и заполни своими значениями
# cp .env.example .env

# -------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------
POSTGRES_DB=f1league
POSTGRES_USER=f1league
POSTGRES_PASSWORD=f1league_secret_change_me

# -------------------------------------------------------
# Backend
# -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://f1league:f1league_secret_change_me@postgres:5432/f1league

# Для Alembic (sync driver)
# DATABASE_URL_SYNC=postgresql+psycopg2://f1league:f1league_secret_change_me@localhost:5432/f1league

# -------------------------------------------------------
# Bot
# -------------------------------------------------------
BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-your-token
TG_CHAT_ID=-100123456789       # ID группового чата (с минусом!)
TG_ADMIN_IDS=123456789         # Твой Telegram ID (через запятую если несколько)
BOT_NOTIFY_SECRET=change-this-secret

# -------------------------------------------------------
# Agent (на PC хоста)
# -------------------------------------------------------
F1_SERVER_URL=http://YOUR_SERVER_IP:8000
F1_WS_URL=ws://YOUR_SERVER_IP:8000/ws/agent
F1_INVITE_TOKEN=your-invite-token
F1_UDP_PORT=20777
F1_SEASON_ID=1

# -------------------------------------------------------
# Frontend
# -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8000
NEXT_PUBLIC_WS_URL=ws://YOUR_SERVER_IP:8000

# -------------------------------------------------------
# Web Auth (NextAuth.js)
# Сгенерировать секрет: openssl rand -base64 32
# -------------------------------------------------------
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://YOUR_SERVER_IP:3000

# Google OAuth:
#   1. https://console.cloud.google.com/
#   2. APIs & Services → Credentials → Create OAuth 2.0 Client
#   3. Authorized redirect URIs: http://YOUR_SERVER_IP:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Публичные URL для Steam OpenID редиректов
FRONTEND_URL=http://YOUR_SERVER_IP:3000
BACKEND_URL=http://YOUR_SERVER_IP:8000

# -------------------------------------------------------
# AI Race Engineer (Groq — бесплатный tier: 30 req/min)
# Получить ключ: https://console.groq.com/
# -------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# -------------------------------------------------------
# Внутренние сервисы (docker-compose сеть)
# -------------------------------------------------------
API_URL=http://backend:8000
BOT_NOTIFY_URL=http://bot:8001/internal/race_uploaded
